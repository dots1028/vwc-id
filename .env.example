# Copy this file to .env.local for local testing.
# On Vercel, add the same five under Settings → Environment Variables.

# From https://discord.com/developers/applications → your app → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The full address of the site, no trailing slash.
# Local:      http://localhost:3000
# Vercel:     https://your-project.vercel.app
SITE_URL=http://localhost:3000

# Any long random string. Signs the login cookie.
# Make one:   openssl rand -hex 32
SESSION_SECRET=

# Your own password for the CSV export at /api/export?token=...
# Make one the same way. Keep it private.
ADMIN_TOKEN=

# Set automatically if you add Neon from the Vercel marketplace.
# Otherwise paste your Postgres connection string here.
DATABASE_URL=
